# Copy to a file outside the repository (for example /etc/agent-dashboard.env, mode 600) and fill in.
# Never commit the real file.

# Proxmox (optional; without these the Proxmox pages stay empty)
PVE_HOST=pve.example.lan
PVE_TOKEN=dashboard@pve!dash=<token secret>
# Proxmox ships a self-signed certificate. Prefer trusting your CA:
#PVE_CA_FILE=/etc/ssl/certs/pve-root-ca.pem
# or, on a trusted LAN only, skip verification:
#PVE_TLS_VERIFY=0

# Two different secrets, so that a compromised agent cannot fake a successful backup. Generate each: openssl rand -hex 16
# AGENT_KEY: agents and machine reporters (POST /api/agent, /api/vms). BACKUP_KEY: only the backup-upload job (POST /api/backup)
AGENT_KEY=<random value>
BACKUP_KEY=<another random value>

# Listen address. 127.0.0.1 keeps the dashboard local (put a reverse proxy in front);
# 0.0.0.0 serves every machine that can reach the host.
BIND=127.0.0.1
PORT=8080

# Sidebar links (shown only when set; the Proxmox link defaults to https://$PVE_HOST:8006)
#PVE_URL=https://pve.example.lan:8006
#OPNSENSE_URL=https://firewall.example.lan
